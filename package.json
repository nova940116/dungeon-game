{
  "name": "arrow-dungeon",
  "private": true,
  "version": "0.1.0",
  "description": "2.5D top-down archer roguelite built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:archer": "node scripts/build-archer.mjs",
    "assets:swordsman": "node scripts/build-swordsman.mjs",
    "assets:bosses": "node scripts/build-bosses.mjs",
    "assets:sounds": "node scripts/fetch-assets.mjs --sounds",
    "balance": "node scripts/balance/run.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
